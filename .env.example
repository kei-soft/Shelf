# Local single-user application. Bind only to loopback.
OPENAI_API_KEY=
LLM_PROVIDER=openai
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_LENGTH=32768
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-local-password
NEO4J_DATABASE=neo4j
DATA_DIR=./data
SHELF_AUTOSTART_WORKER=true
# Optional OCR: uv sync --extra ocr; install Tesseract + kor/eng language data.
OCR_ENABLED=false
OCR_LANGUAGE=kor+eng
